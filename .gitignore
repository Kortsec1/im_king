# Public repository allowlist. Raw photos, biometric embeddings, local
# environments, and iCloud placeholders intentionally remain local.
*
!.gitignore
!README.md

!backend/
backend/*
!backend/app_v2.py
!backend/dataset_import.py
!backend/hair_features.py
!backend/tests/
backend/tests/*
!backend/tests/test_dataset_import.py
!backend/tests/test_hair_features.py
!cloudflare-worker/test-photo-attributes.mjs
!backend/requirements.txt
!backend/scripts/
backend/scripts/*
!backend/scripts/prepare_gallery_v2.py
!backend/scripts/export_gallery_web.py
!backend/scripts/export_photo_catalog.py
!backend/data/
backend/data/*
!backend/data/gallery_v2/
backend/data/gallery_v2/*
!backend/data/gallery_v2/index.json

!frontend/
frontend/*
!frontend/dist/
!frontend/dist/**
frontend/dist/.vercel/

!scripts/
scripts/*
!scripts/dev_gateway.py
!scripts/queue_worker.py
!scripts/start_backend.ps1
!scripts/start_queue_worker.ps1
!scripts/start_local.ps1
!scripts/restart_services.ps1
!scripts/install_hair_model.ps1
!backend/scripts/prepare_reference_features.py
!cloudflare-worker/
cloudflare-worker/*
!cloudflare-worker/src/
!cloudflare-worker/src/**
!cloudflare-worker/wrangler.jsonc
!cloudflare-worker/schema.sql
!cloudflare-worker/dataset-schema.sql
!cloudflare-worker/package.json
!cloudflare-worker/package-lock.json
!cloudflare-worker/test-dataset.mjs
!cloudflare-worker/test-audit-auth.mjs
!cloudflare-worker/test-photo-attributes.mjs
!cloudflare-worker/gender-schema.sql
!cloudflare-worker/attributes-schema.sql
!cloudflare-worker/match-preference-schema.sql
.vercel

!cloudflare-worker/audit-schema.sql
!supabase/
!supabase/*.sql
!supabase/migrations/
!supabase/migrations/*.sql
!supabase/functions/
!supabase/functions/admin-api/
!supabase/functions/admin-api/*.ts
